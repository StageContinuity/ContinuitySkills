{
  "schemaVersion": 1,
  "preserve": [
    "spuree-agent"
  ],
  "replacements": [
    {
      "from": "https://github.com/CheehooLabs/SpureeSkills",
      "to": "https://github.com/StageContinuity/ContinuitySkills",
      "reason": "Install commands and links point at this repository"
    },
    {
      "from": "CheehooLabs/SpureeSkills",
      "to": "StageContinuity/ContinuitySkills",
      "reason": "Bare repository slug"
    },
    {
      "from": "studio\\.spuree\\.com",
      "to": "folio\\.stagecontinuity\\.com",
      "reason": "Regex-escaped web app host in the contract checker"
    },
    {
      "from": "data\\.spuree\\.com",
      "to": "data\\.stagecontinuity\\.com",
      "reason": "Regex-escaped API host in the contract checker"
    },
    {
      "from": "studio.spuree.com",
      "to": "folio.stagecontinuity.com",
      "reason": "Web app host"
    },
    {
      "from": "data.spuree.com",
      "to": "data.stagecontinuity.com",
      "reason": "API host"
    },
    {
      "from": "spuree.com",
      "to": "stagecontinuity.com",
      "reason": "Main site, after both subdomains"
    },
    {
      "from": "Spuree Studio",
      "to": "Folio",
      "reason": "The web app's product name; must run before the bare words"
    },
    {
      "from": "SPUREE_",
      "to": "CONTINUITY_",
      "reason": "Environment variable prefix"
    },
    {
      "from": "SpureeSkills",
      "to": "ContinuitySkills",
      "reason": "Repository name"
    },
    {
      "from": "Name it **Spuree**",
      "to": "Name it **Folio Continuity**",
      "reason": "The connection name a person types into ChatGPT or claude.ai is the product name, not the bare brand (it collides with other apps called Continuity)"
    },
    {
      "from": "resulting **Spuree** plugin",
      "to": "resulting **Folio Continuity** plugin",
      "reason": "Same connection name, in the ChatGPT install step"
    },
    {
      "from": "@Spuree",
      "to": "@Folio Continuity",
      "reason": "Same connection name, as the @-mention in ChatGPT"
    },
    {
      "from": "Connect Spuree",
      "to": "Connect Folio Continuity",
      "reason": "The ChatGPT desktop app's Connect dialog shows the plugin name"
    },
    {
      "from": "Continue to Spuree",
      "to": "Continue to Folio Continuity",
      "reason": "Same dialog's button"
    },
    {
      "from": "Settings > Plugins > Spuree >",
      "to": "Settings > Plugins > Folio Continuity >",
      "reason": "ChatGPT lists the plugin under its connection name"
    },
    {
      "from": "Spuree",
      "to": "Continuity",
      "reason": "Brand name"
    },
    {
      "from": "spuree",
      "to": "continuity",
      "reason": "Lowercase brand name (MCP server names, test fixture prefixes)"
    },
    {
      "from": "Studio",
      "to": "Folio",
      "reason": "The web app; runs last so host rules are not disturbed"
    }
  ],
  "residue": [
    "spuree",
    "Spuree",
    "SPUREE",
    "Studio",
    "studio"
  ]
}
